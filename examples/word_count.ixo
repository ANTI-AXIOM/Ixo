# Counts words in a file (this file by default) and prints the most common.
#   ixo examples/word_count.ixo some_file.txt

default = if fs.has("word_count.ixo") -> "word_count.ixo" else "examples/word_count.ixo"
path = args.get(0, default)
text = fs.read(path) ! err
    print(f"can't read {path}: {err.msg}")
    exit(1)

counts = {}
for word in text.down.cut
    w = word.trim
    if w.len < 3 or not w[0].is_alpha -> continue
    counts[w] = counts.get(w, 0) + 1

top = counts.pairs.sort(_a[1] > _b[1]).slice(0, 5)
print(f"{counts.len} different words; the most common:")
for (word, n) in top
    print(f"  {word:<10} {n:>3}")
