# Conway's Game of Life on a small torus, using a set of (x, y) tuples.

W = 12
H = 8

fn neighbors(cell)
    x, y = cell
    out = []
    for dx in -1..=1
        for dy in -1..=1
            if dx == 0 and dy == 0 -> continue
            out.add(((x + dx) % W, (y + dy) % H))
    out

fn step(alive)
    counts = {}
    for cell in alive
        for n in neighbors(cell)
            counts[n] += 1
    next = set()
    for cell, c in counts
        if c == 3 or (c == 2 and cell in alive) -> next.add(cell)
    next

fn show(alive)
    for y in 0..H
        row = ""
        for x in 0..W
            row += if (x, y) in alive -> "#" else "."
        print(row)
    print("")

# a glider
alive = {(1, 0), (2, 1), (0, 2), (1, 2), (2, 2)}
for gen in 0..3
    print(f"generation {gen}:")
    show(alive)
    alive = step(alive)
