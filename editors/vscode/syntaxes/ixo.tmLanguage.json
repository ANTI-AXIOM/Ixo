{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ixo",
  "scopeName": "source.ixo",
  "patterns": [
    {
      "include": "#statements"
    }
  ],
  "repository": {
    "statements": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#docstring"
        },
        {
          "include": "#fn-def"
        },
        {
          "include": "#class-def"
        },
        {
          "include": "#decorator"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "comment": {
      "name": "comment.line.number-sign.ixo",
      "match": "#.*$"
    },
    "docstring": {
      "name": "string.quoted.docstring.ixo",
      "begin": "^\\s*\"\"\"",
      "end": "\"\"\""
    },
    "fn-def": {
      "match": "\\b((?:fork|par)\\s+)?(fn)\\s+([A-Za-z_][A-Za-z0-9_]*!?|\\[\\]=?|==|<|\\*\\*|[-+*/%])(\\*)?",
      "captures": {
        "1": {
          "name": "keyword.control.fork.ixo"
        },
        "2": {
          "name": "storage.type.function.ixo"
        },
        "3": {
          "name": "entity.name.function.ixo"
        },
        "4": {
          "name": "storage.modifier.export.ixo"
        }
      }
    },
    "class-def": {
      "match": "\\b(class|interface|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\*)?",
      "captures": {
        "1": {
          "name": "storage.type.class.ixo"
        },
        "2": {
          "name": "entity.name.type.class.ixo"
        },
        "3": {
          "name": "storage.modifier.export.ixo"
        }
      }
    },
    "decorator": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.ixo",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "storage.modifier.hint.ixo",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#rawstring"
        },
        {
          "include": "#fstring"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#types"
        },
        {
          "include": "#builtins"
        },
        {
          "include": "#placeholder"
        },
        {
          "include": "#member-call"
        },
        {
          "include": "#member"
        },
        {
          "include": "#call"
        },
        {
          "include": "#class-name"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "fstring": {
      "patterns": [
        {
          "name": "string.quoted.triple.interpolated.ixo",
          "begin": "(f)(\"\"\")",
          "end": "\"\"\"",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.ixo"
            }
          },
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.interpolated.ixo",
          "begin": "(f)(\")",
          "end": "\"",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.ixo"
            }
          },
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.interpolated.ixo",
          "begin": "(f)(')",
          "end": "'",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.ixo"
            }
          },
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "constant.character.escape.ixo",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.interpolation.ixo",
          "begin": "\\{",
          "end": "(:[^}\\\"']*)?\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.ixo"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.ixo"
            },
            "1": {
              "name": "storage.modifier.format-spec.ixo"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.triple.ixo",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.double.ixo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.single.ixo",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.ixo",
      "match": "\\\\(u\\{[0-9a-fA-F]+\\}|x[0-9a-fA-F]{2}|.)"
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ixo",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.ixo",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.ixo",
          "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?(ms|s)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ixo",
          "match": "\\b(if|elif|else|while|for|in|match|return|break|continue|retry|with|tasks|fork|par|select|defer|use|as|todo)\\b"
        },
        {
          "name": "storage.type.ixo",
          "match": "\\b(fn|class|interface|enum)\\b"
        },
        {
          "name": "keyword.operator.logical.ixo",
          "match": "\\b(and|or|not|is)\\b"
        },
        {
          "name": "keyword.operator.range.ixo",
          "match": "(?<=[\\w)\\]]\\s)by\\b(?=\\s)"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ixo",
          "match": "\\b(true|false|nil|null)\\b"
        },
        {
          "name": "variable.language.self.ixo",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "name": "support.type.ixo",
      "match": "\\b(int|float|num|str|bool|list|map|set|tuple|range|flow|task|vec|mat|quat|time|rng|any|iter|void|Error|Result)\\b(?!\\s*\\()"
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.ixo",
          "match": "\\b(print|write|input|str|int|float|bool|type|len|range|list|tuple|set|error|is_error|panic|assert|assert_eq|exit|ord|chr|min|max|abs|sqrt|sum|zip|flow|sleep|now|clock|args)\\b(?=\\s*\\()"
        },
        {
          "name": "support.class.module.ixo",
          "match": "\\b(fs|math|os|net|json|rng|vec|mat|quat)\\b(?=\\s*\\.)"
        }
      ]
    },
    "placeholder": {
      "name": "variable.parameter.placeholder.ixo",
      "match": "\\b_[A-Za-z0-9_]*\\b"
    },
    "member-call": {
      "match": "(?<=\\.)([A-Za-z_][A-Za-z0-9_]*!?)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.member.ixo"
        }
      }
    },
    "member": {
      "match": "(?<=\\.)([A-Za-z_][A-Za-z0-9_]*!?)",
      "captures": {
        "1": {
          "name": "variable.other.property.ixo"
        }
      }
    },
    "call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.ixo"
        }
      }
    },
    "class-name": {
      "name": "entity.name.type.ixo",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.reference.ixo",
          "match": "&(?=[A-Za-z_])"
        },
        {
          "name": "keyword.operator.flow.ixo",
          "match": ":>|<:"
        },
        {
          "name": "keyword.operator.arrow.ixo",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.ixo",
          "match": "\\.\\.[<=]?"
        },
        {
          "name": "keyword.operator.error.ixo",
          "match": "\\?|!(?!=)"
        },
        {
          "name": "keyword.operator.ixo",
          "match": "~/=?|\\+\\+|--|\\*\\*=?|//|==|!=|<=|>=|<<|>>|[-+*/%]=?|[<>&|^~]|="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.ixo",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.ixo",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.ixo",
          "match": "\\."
        }
      ]
    },
    "rawstring": {
      "patterns": [
        {
          "name": "string.quoted.triple.raw.ixo",
          "begin": "(r)(\"\"\")",
          "end": "\"\"\"",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.ixo"
            }
          }
        },
        {
          "name": "string.quoted.double.raw.ixo",
          "begin": "(r)(\")",
          "end": "\"",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.ixo"
            }
          }
        },
        {
          "name": "string.quoted.single.raw.ixo",
          "begin": "(r)(')",
          "end": "'",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.ixo"
            }
          }
        }
      ]
    }
  }
}
