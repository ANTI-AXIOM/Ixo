class Account(owner, balance)
    fn describe = f"{self.owner}: {self.balance}"
    fn deposit(n)
        self.balance += n

fn show(a: & Account) = a.describe                # reading is fine
fn pay(a: & mut Account, n) = a.deposit(n)        # &mut allows changes
fn total(xs: & list[int]): int = xs.sum

acc = Account("ann", 10)
pay(acc, 5)
print(show(acc), total([1, 2, 3]))                # expect: ann: 15 6
