class Box[T](value: T)
    fn get: T = self.value
    fn map(f) = Box(f(self.value))

class Stack[T]
    items: list[T] = []
    fn push(x: T)
        self.items.add(x)
    fn pop: T? = if self.items.len > 0 -> self.items.take else nil

b = Box(41)
n: int = b.get + 1
print(n, b.map(str).get)                  # expect: 42 41

s: Stack[str] = Stack()
s.push("a")
s.push("b")
print(s.pop, s.pop, s.pop)                # expect: b a nil

class Pair[K, V](key: K, value: V)
p = Pair("x", 1)
print(p.key, p.value)                     # expect: x 1

interface Shape
    fn area: float
interface Solid is Shape
    fn volume: float
    fn describe = f"area {self.area}, volume {self.volume}"

class Cube(side: float) is Solid
    fn area: float = 6 * self.side * self.side
    fn volume: float = self.side ** 3

c = Cube(2.0)
print(c.describe, c is Shape, c is Solid)  # expect: area 24.0, volume 8.0 true true
fn total_area(shapes: list[Shape]): float = shapes.map(_.area).sum
print(total_area([c]))                    # expect: 24.0
