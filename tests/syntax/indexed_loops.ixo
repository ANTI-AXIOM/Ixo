# Two names: the position (or key) and the item. Parentheses unpack each item.
for i, x in ["a", "b", "c"] -> print(i, x)
# expect: 0 a
# expect: 1 b
# expect: 2 c
for i, c in "hé!" -> print(i, c)
# expect: 0 h
# expect: 1 é
# expect: 2 !
for i, n in 10..=30 by 10 -> print(i, n)
# expect: 0 10
# expect: 1 20
# expect: 2 30
for k, v in {"x": 1, "y": 2} -> print(k, v)
# expect: x 1
# expect: y 2
for (name, score) in [("ann", 3), ("bo", 5)] -> print(name, score)
# expect: ann 3
# expect: bo 5
for i, (a, b) in [(1, 2), (3, 4)] -> print(i, a + b)
# expect: 0 3
# expect: 1 7
for a, b, c in [(1, 2, 3)] -> print(a + b + c)   # expect: 6
total = 0
for i, x in [5, 6, 7]
    if i == 1 -> continue
    total += i * x
print(total)                                     # expect: 14
for i, t in (4, 5) -> print(i, t)
# expect: 0 4
# expect: 1 5
