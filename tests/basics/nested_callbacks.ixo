# Natives that call back into Ixo (sort comparators, str methods) while many
# frames are live: regression test for frame/stack reallocation during callbacks.
class Item(n)
    fn str = f"<{self.n}>"

fn deep(k, items)
    if k == 0
        return items.sort(_a.n > _b.n).map(str(_))
    deep(k - 1, items)

items = (1..=20).map(Item(_))
print(deep(50, items).slice(0, 3))    # expect: ["<20>", "<19>", "<18>"]
print(Item(1), Item(2), Item(3), Item(4), Item(5), Item(6), Item(7), Item(8))  # expect: <1> <2> <3> <4> <5> <6> <7> <8>
l = [3, 1, 2]
l.add(4)
print(l.sort, l.sort(_a > _b), l.rev, l.sum, l.min, l.uniq)  # expect: [1, 2, 3, 4] [4, 3, 2, 1] [4, 2, 1, 3] 10 1 [3, 1, 2, 4]
words = ["ccc", "a", "bb"]
words.sort!(_a.len < _b.len)
print(words, words.sort_by(-_.len))   # expect: ["a", "bb", "ccc"] ["ccc", "bb", "a"]
