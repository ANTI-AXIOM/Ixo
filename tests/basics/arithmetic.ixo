print(1 + 2)                 # expect: 3
print(7 - 10)                # expect: -3
print(6 * 7)                 # expect: 42
print(7 / 2)                 # expect: 3.5
print(8 / 2)                 # expect: 4.0
print(7 % 3, -7 % 3)         # expect: 1 2
print(2 ** 10, 2 ** -1)      # expect: 1024 0.5
print(27.root(3), 16.root(2), 2.root(2))  # expect: 3 4 1.4142135623730951
print(7 // 2, -7 // 2, 7.5 // 2)  # expect: 3 -4 3.0
print(2.0 ** 0.5)            # expect: 1.4142135623730951
print(0.1 + 0.2)             # expect: 0.30000000000000004
print(1 + 2 * 3, (1 + 2) * 3)  # expect: 7 9
two = 2
print(-two ** 2, (-2) ** 2, -(2 ** 2))  # expect: -4 4 -4
five = 5
print(-five.abs, (-5).abs)    # expect: -5 5
print(10 / 4 * 2)            # expect: 5.0
print(1_000_000, 0xff, 0b101)  # expect: 1000000 255 5
print(1e3, 2.5e-1)           # expect: 1000.0 0.25
print(5 & 3, 5 | 3, 5 ^ 3, 1 << 4, 256 >> 2)  # expect: 1 7 6 16 64
print(~0)                    # expect: -1
x = 5
x += 2
x *= 3
x -= 1
x /= 4
print(x)                     # expect: 5.0
y = 2
y **= 3
y++
print(y)                     # expect: 9
y--
y--
print(y)                     # expect: 7
print(3 == 3.0, 1 < 2, 2 <= 2, 3 > 4, 4 >= 4, 1 != 2)  # expect: true true true false true true
print(10.5.floor, 10.5.ceil, 10.5.round, (-3.7).int)    # expect: 10 11 11 -3
print(3.14159.round(2))      # expect: 3.14
print(5.clamp(1, 3), 2.5.lerp(4.5, 0.5))                # expect: 3 3.5
print(1 / 3)                 # expect: 0.3333333333333333
print(9223372036854775807 + 1)   # expect: -9223372036854775808
print(4.even, 7.odd, (-3).abs, 2.pow(8))                # expect: true true 3 256
