nums = [5, 3, 8, 1]
print(nums.map(_ * 10))               # expect: [50, 30, 80, 10]
print(nums.keep(_ % 2 == 1))          # expect: [5, 3, 1]
print(nums.sort(_a > _b))             # expect: [8, 5, 3, 1]
print(nums.fold(0, _a + _b))          # expect: 17
print(nums.fold(0, -> _a + _b))       # expect: 17
print(nums.any(_ > 7), nums.all(_ > 0))  # expect: true true
print(nums.count(_ > 2), nums.count(3))  # expect: 3 1
print(nums.find_by(_ > 4))            # expect: 5
print(nums.map(str(_)))               # expect: ["5", "3", "8", "1"]
words = ["kiwi", "fig", "banana"]
print(words.map(_.len))               # expect: [4, 3, 6]
print(words.sort_by(_.len))           # expect: ["fig", "kiwi", "banana"]
print(words.min_by(_.len), words.max_by(_.len))  # expect: fig banana
nums.each -> print(_ + 1)
# expect: 6
# expect: 4
# expect: 9
# expect: 2
squares = nums.map -> _ * _
print(squares)                        # expect: [25, 9, 64, 1]
total = 0
nums.each ->
    total += _
print(total)                          # expect: 17
sq = fn(x) = x * x
print(sq(9))                          # expect: 81
print([(1, "b"), (0, "a")].sort)      # expect: [(0, "a"), (1, "b")]
print((1..=4).map(_ * _))             # expect: [1, 4, 9, 16]
3.times(print(_))
# expect: 0
# expect: 1
# expect: 2
print(nums.group_by(_ % 2))           # expect: {1: [5, 3, 1], 0: [8]}
print(nums.partition(_ > 4))          # expect: ([5, 8], [3, 1])
print(nums.skip(_ > 4))               # expect: [3, 1]
print(nums.sum_by(_ * 2))             # expect: 34
print([[1, 2], [3]].flat_map(_.rev))  # expect: [2, 1, 3]
add = fn(a, b = 1) = a + b
print(add(1), add(1, 5))              # expect: 2 6
print(nums.map(fn(n) = n + 1))       # expect: [6, 4, 9, 2]
class P(x, y)
pts = [(1, 2), (3, 4)].map(P(_[0], _[1]))
print(pts.map(_.x))                   # expect: [1, 3]
print([1, 5].map(max(_, 2)))          # expect: [2, 5]
fn apply(f, x) = f(x)
print(apply(_ * 3, 7))                # expect: 21
print([[3, 1], [2]].map(_.sort(_a > _b)))  # expect: [[3, 1], [2]]
