for i in 0..3 -> print(i)
# expect: 0
# expect: 1
# expect: 2
for i in 1..=3
    print(i * 10)
# expect: 10
# expect: 20
# expect: 30
for c in "hé" -> print(c)
# expect: h
# expect: é
total = 0
for i in 0..100
    if i % 2 == 0 -> continue
    if i > 10 -> break
    total += i
print(total)                          # expect: 25
for i, x in ["p", "q"] -> print(i, x)
# expect: 0 p
# expect: 1 q
for k, v in {"a": 1, "b": 2} -> print(k, v)
# expect: a 1
# expect: b 2
for k in {"x": 1} -> print(k)         # expect: x
for (a, b) in [(1, 2), (3, 4)] -> print(a + b)
# expect: 3
# expect: 7
count = 0
for _ in 1..=5 -> count++
print(count)                          # expect: 5
for i in 0..3
    for j in 0..3
        if j == 1 -> break
        print(i, j)
# expect: 0 0
# expect: 1 0
# expect: 2 0
i = 10
while true
    i -= 3
    if i < 0 -> break
print(i)                              # expect: -2
fns = []
for k in 0..3
    fns.add(fn = k)
print(fns.map(_()))                   # expect: [0, 1, 2]
for s in {3, 1} -> print(s)
# expect: 3
# expect: 1
for i in 5..=1 by -2 -> print(i)
# expect: 5
# expect: 3
# expect: 1
