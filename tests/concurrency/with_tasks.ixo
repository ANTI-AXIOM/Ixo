log = []
with tasks
    for i in 0..3
        fork fn = log.add(i)
print(log.sort)                       # expect: [0, 1, 2]

fn compute(x) = x * 2
with tasks
    fork compute(21) -> r
        print(f"result {r}")          # expect: result 42

out = flow(10)
with tasks
    fork fn
        30.wait
        "slow" :> out
    fork fn
        5.wait
        "fast" :> out
out.close
for m <: out -> print(m)
# expect: fast
# expect: slow

fn square(x) = x * x
tasks = (1..=3).map(fork square(_))
print(tasks.map(_.await))             # expect: [1, 4, 9]
