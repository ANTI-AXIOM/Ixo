l = [1, 2, 3]
l.add(4)
print(l, l.len, len(l))               # expect: [1, 2, 3, 4] 4 4
print(l[0], l[-1], l[1..3])          # expect: 1 4 [2, 3]
print(l.get(10), l.get(10, "none"))   # expect: nil none
l[0] = 10
print(l)                              # expect: [10, 2, 3, 4]
print(l.take, l)                      # expect: 4 [10, 2, 3]
l.insert(1, 99)
print(l)                              # expect: [10, 99, 2, 3]
print(l.drop(1), l)                   # expect: 99 [10, 2, 3]
print(l.remove(2), l)                 # expect: true [10, 3]
print(l.has(3), 3 in l, 7 in l)       # expect: true true false
print(l.find(3), l.find(7))           # expect: 1 nil
print([3, 1, 2].sort, [3, 1, 2].rev)  # expect: [1, 2, 3] [2, 1, 3]
m = [3, 1, 2]
m.sort!
print(m)                              # expect: [1, 2, 3]
print([1, 2] + [3], [0] * 3)          # expect: [1, 2, 3] [0, 0, 0]
print([1, 2, 3].sum, [1, 2, 3, 4].prod, [4, 9, 2].min, [4, 9, 2].max)  # expect: 6 24 2 9
print([1, 1, 2, 3, 3].uniq)           # expect: [1, 2, 3]
print([1, 2, 3, 4, 5].chunks(2))      # expect: [[1, 2], [3, 4], [5]]
print([1, 2] == [1, 2], [1, 2] == [2, 1])  # expect: true false
print([].is_empty, [].first, [5].last)     # expect: true nil 5
print(list("abc"), list(1..=3))       # expect: ["a", "b", "c"] [1, 2, 3]
print([1, [2, 3]].flat)               # expect: [1, 2, 3]
print(zip([1, 2], ["a", "b"]))        # expect: [(1, "a"), (2, "b")]
nested = [[1, 2], [3, 4]]
nested[1][0] = 30
print(nested)                         # expect: [[1, 2], [30, 4]]
a, b = 1, 2
a, b = b, a
print(a, b)                           # expect: 2 1
xs = [1, 2, 3]
xs[0], xs[2] = xs[2], xs[0]
print(xs)                             # expect: [3, 2, 1]
xs[1] += 5
print(xs)                             # expect: [3, 7, 1]
print([1, 2, 3].slice(1), [1, 2, 3].join(", "))  # expect: [2, 3] 1, 2, 3
big = []
for i in 0..10000 -> big.add(i)
print(big.len, big.sum)               # expect: 10000 49995000
print(["b", "a"].sort, [2.5, 1, 2].sort)  # expect: ["a", "b"] [1, 2, 2.5]
