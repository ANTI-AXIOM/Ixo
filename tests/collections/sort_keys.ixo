# sort_by(_.field) reads the field directly; the result must be what calling the lambda gives.
class P(name, age)
class Q(name, age)
    fn label = f"q-{name}"
ps = [P("a", 3), P("b", 1), P("c", 3), P("d", 2), P("e", 1)]
print(ps.sort_by(_.age).map(_.name))                   # expect: ["b", "e", "d", "a", "c"]
print(ps.sort_by(_.name).map(_.age))                   # expect: [3, 1, 3, 2, 1]
mixed = [P("x", 2.5), Q("y", 1), P("z", -1)]
print(mixed.sort_by(_.age).map(_.name))                # expect: ["z", "y", "x"]
print([Q("m", 1), Q("k", 0)].sort_by(_.label).map(_.name))  # expect: ["k", "m"]
print([3, 1, 2].sort_by(_ * -1))                       # expect: [3, 2, 1]
print(["bb", "a", "ccc"].sort_by(_.len))               # expect: ["a", "bb", "ccc"]
big = []
for i in 0..1000 -> big.add(P(f"p{i}", (i * 7) % 10))
s = big.sort_by(_.age)
print(s[0].name, s[99].name, s[100].name, s[999].name)  # expect: p0 p990 p3 p997
