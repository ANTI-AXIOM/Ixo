# Length of the longest common subsequence of two DNA strings (dynamic programming).
fn dna(seed, n)
    x, out = seed, []
    for _ in 0..n
        x = (x * 1103515245 + 12345) % 2_147_483_648
        out.add("ACGT"[(x >> 16) & 3])
    out.join

a, b = dna(1, 1500), dna(2, 1500)
prev = [0] * (b.len + 1)
for ca in a
    row = [0]
    for j, cb in b -> row.add(if ca == cb -> prev[j] + 1 else max(prev[j + 1], row[j]))
    prev = row
print(prev.last)
