# The five most frequent words of a text.
words = "the quick brown fox jumps over the lazy dog and the cat sat on the mat".cut
text = (0..200_000).map(words[_ * 7 % words.len]).join(" ")
counts = {}
for w in text.cut -> counts[w] = counts.get(w, 0) + 1
for (w, n) in counts.pairs.sort_by((-_[1], _[0]))[..5] -> print(w, n)
