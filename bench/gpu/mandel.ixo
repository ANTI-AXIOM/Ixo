# Mandelbrot, 1024 x 768, up to 256 iterations per pixel: one thread per pixel
gpu fn mandel(out: buffer[int], w: int, h: int, iters: int)
    p = gpu.index
    x0 = float(p % w) / float(w) * 3.5 - 2.5
    y0 = float(p // w) / float(h) * 2.0 - 1.0
    x = 0.0
    y = 0.0
    k = 0
    while k < iters and x * x + y * y <= 4.0
        t = x * x - y * y + x0
        y = 2.0 * x * y + y0
        x = t
        k += 1
    out[p] = k

w = 1024
h = 768
out = gpu.ints(w * h)
mandel(out, w, h, 256)  # (the first launch builds the kernel)
t0 = clock()
for r in 0..10 -> mandel(out, w, h, 256)
t = (clock() - t0) / 10
print(out.list.sum)
print(f"time {t}")
